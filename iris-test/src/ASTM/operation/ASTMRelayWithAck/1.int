ApplyCommentC2ToOrderO12(pInput,pC2="") methodimpl {
	Set tCR = $C(13)
	Set tNorm = $Replace($Replace(pInput,$C(13,10),tCR),$C(10),tCR)
	Set tOut = ""
	Set pC2 = ""
	For i=1:1:$L(tNorm,tCR) {
		Set tLine = $P(tNorm,tCR,i)
		Continue:tLine=""
		Set tType = $P(tLine,"|",1)
		If tType="C" {
			Set pC2 = $P(tLine,"|",3)
		} ElseIf (tType="O")&&(pC2'="") {
			Set $P(tLine,"|",13) = pC2
		}
		Set tOut = tOut_tLine_tCR
	}
	Quit tOut }
BuildApplicationAck(pSC) methodimpl {
